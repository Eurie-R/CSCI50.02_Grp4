| |||||||||||||||||||||||||||||||
| Bubble Sort
| |||||||||||||||||||||||||||||||
		
		len = r0
		i = r1
		swapped = r2
		cur = r5
		next = r6
        
		| initialisation
		LD(r31, INPUT, len)
		
START:
		CMOVE(0,i)
		CMOVE(0,swapped)

OUTLOOP:
		| for (i=0; i < len; i++)
		ADDC(i,1,i)
		CMPLT(i,len,r3)
		BEQ(r3,END)

INLOOP:		
		| calculate address of arr[i], store into r4
		SHLC(i,2,r4)
		LD(r4,INPUT,cur)
		LD(r4,INPUT+4,next)
		
		| if cur < next == 1, break
		CMPLT(cur,next,r7)
		BNE(r7,OUTLOOP)
		
		| if cur < next == 0, swap
		ST(next,INPUT,r4)
		ST(cur,INPUT+4,r4)
		CMOVE(1,swapped)
		BR(OUTLOOP)
END:
		BNE(swapped,START)
		HALT()

. = 0x19C

INPUT:
        LONG(3)		| array length
        LONG(4)
        LONG(6)
        LONG(2)
		
OUTPUT:
